module WChar exposing (graphemeWidth)

import Array exposing (Array)


{-| Number of grid cells (1 or 2) a grapheme cluster takes. Every grapheme takes
at least one cell. It takes two if its first character is East Asian Wide or
Fullwidth, or if it asks for emoji presentation (U+FE0F), as in "❤️".
Combining marks are part of the grapheme, so they need no table of their own.
-}
graphemeWidth : String -> Int
graphemeWidth grapheme =
    case String.uncons grapheme of
        Just ( char, rest ) ->
            if String.contains emojiPresentation rest || binarySearch (Char.toCode char) wideEastern then
                2

            else
                1

        Nothing ->
            1


{-| VARIATION SELECTOR-16 (U+FE0F)
-}
emojiPresentation : String
emojiPresentation =
    String.fromChar (Char.fromCode 0xFE0F)



--
-- Privates
--


type alias CharTable =
    Array ( Int, Int )


binarySearch : Int -> CharTable -> Bool
binarySearch ucs table =
    let
        min =
            0

        max =
            Array.length table
    in
    bisearchHelper ucs table min max


bisearchHelper : Int -> CharTable -> Int -> Int -> Bool
bisearchHelper ucs table min max =
    let
        mid =
            (min + max) // 2
    in
    case Array.get mid table of
        Just ( beginning, ending ) ->
            if max < min then
                False

            else if ucs > ending then
                bisearchHelper ucs table (mid + 1) max

            else if ucs < beginning then
                bisearchHelper ucs table min (mid - 1)

            else
                True

        Nothing ->
            False



